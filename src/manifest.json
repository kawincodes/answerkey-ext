{
  "manifest_version": 3,
  "name": "AnswerKey – Ask Claude",
  "short_name": "AnswerKey",
  "version": "0.0.0",
  "description": "Select text on any page and get an answer from Claude, using your own Anthropic API key.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "AnswerKey",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "contextMenus", "activeTab", "scripting"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "ask-selection": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Ask Claude about the selected text"
    }
  }
}
