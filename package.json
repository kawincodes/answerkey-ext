{
  "name": "answerkey-ext",
  "version": "1.0.0",
  "private": true,
  "description": "Microsoft Edge extension: select text on any page and get answers from Claude using your own Anthropic API key.",
  "homepage": "https://github.com/kawincodes/answerkey-ext#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kawincodes/answerkey-ext.git"
  },
  "bugs": {
    "url": "https://github.com/kawincodes/answerkey-ext/issues"
  },
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "zip": "node build.mjs --zip",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build && node tests/e2e.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "dompurify": "^3.4.17",
    "lucide": "^1.66.0",
    "lucide-react": "^1.66.0",
    "marked": "^18.1.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
